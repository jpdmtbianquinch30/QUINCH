# Fichier d'environnement utilisé PAR LES CONTENEURS Docker (services "app"
# et "queue" dans docker-compose.yml), distinct de backend/.env utilisé quand
# Laravel tourne en dehors de Docker (php artisan serve en local).
#
# Copier vers backend/.env.docker (ignoré par git) et renseigner les vraies
# valeurs (notamment DB_PASSWORD = même valeur que POSTGRES_PASSWORD dans le
# .env racine, et APP_KEY générée séparément — voir README).
#
APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=quinch
DB_USERNAME=quinch_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paiements webhook secrets
ORANGE_MONEY_WEBHOOK_SECRET=
WAVE_WEBHOOK_SECRET=

# ─── QUINCH V1 - Feature flags ───────────────────────────────────────────────
# CORRIGE : cash_delivery/free_money ne sont plus supportés depuis la
# migration 2026_09_31_restrict_payment_methods_and_split_order_status (ni la
# contrainte CHECK en base, ni PaymentGatewayFactory ne les gèrent). Les
# laisser ici causait un 422 systématique sur toute tentative d'achat en
# prod. V1 réelle : uniquement Wave (voir WaveGateway.php). Orange Money est
# implémenté mais désactivé en attendant la confirmation des champs webhook
# avec la doc Sonatel.
QUINCH_PAYMENT_METHODS=wave

QUINCH_FEATURE_NEGOTIATION=false
QUINCH_FEATURE_FOLLOW=false
QUINCH_FEATURE_REVIEWS=false
QUINCH_FEATURE_BADGES=false
QUINCH_FEATURE_SHARING=false
QUINCH_FEATURE_CHAT_AUDIO=false
QUINCH_FEATURE_CHAT_FILE=false
QUINCH_FEATURE_FAVORITES_COLLECTIONS=false

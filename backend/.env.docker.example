# Fichier d'environnement des conteneurs Docker (app, queue, queue_videos, scheduler).
# Copier vers backend/.env.docker (ignoré par git) et remplacer toutes les valeurs CHANGE_ME.
# Au démarrage, `php artisan quinch:preflight` REFUSE de lancer le conteneur si une
# valeur dangereuse subsiste (SMS_DRIVER=log, CORS localhost, secret Wave vide...).

APP_NAME=QUINCH
APP_ENV=production
# php artisan key:generate --show   (à lancer une fois, puis coller ici)
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.quinch.sn

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# IP réelle des visiteurs : le nginx de production (production.conf) la fournit
# déjà à PHP, derrière Caddy. Laisser TRUSTED_PROXIES VIDE (ou absent).
# NE PAS mettre « * » : Laravel ferait alors confiance à un en-tête
# X-Forwarded-For envoyé par le visiteur, qui pourrait ainsi usurper n'importe
# quelle IP et contourner bannissements et limitations de débit par IP.
# À renseigner (IP précises) seulement si un autre proxy précède nginx.
TRUSTED_PROXIES=

# ─── Base de données (valeurs du .env racine) ─────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=quinch
DB_USERNAME=quinch_user
DB_PASSWORD=CHANGE_ME

# ─── Redis : cache + files d'attente + sessions + limiteurs ──────────────────
# Les workers du docker-compose lisent la file « redis » : QUEUE_CONNECTION
# DOIT valoir redis, sinon les e-mails (code de réinitialisation) ne partent jamais.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies : l'API s'authentifie par jeton, mais tout cookie émis doit être sécurisé.
# Le contrôle de démarrage (quinch:preflight) refuse la production sans ces valeurs.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Stockage médias : disque local (volume Docker) pour l'instant. La migration
# vers un stockage objet S3 + CDN est prévue à la phase « charge et exploitation ».

# ─── E-mail : identifiant de connexion + code « mot de passe oublié » ─────────
# En production « log » et « array » sont refusés (aucun e-mail ne partirait et
# personne ne pourrait récupérer son compte). Utiliser un service transactionnel
# en SMTP (aucun paquet à installer), avec SPF + DKIM + DMARC configurés sur le
# domaine de l'expéditeur, sinon les messages finissent en spam (voir
# backend/EMAIL_CODES.md). Les e-mails partent par la file Redis : le service
# « queue » du docker-compose doit tourner.
#
# MAIL_SCHEME : « smtp » avec le port 587 (STARTTLS) ou « smtps » avec le port
# 465 (TLS direct). Pas d'autre valeur (« tls » et « ssl » ne sont pas documentées).
#
# Exemples (hôtes à confirmer dans le tableau de bord de votre fournisseur) :
#   Brevo    : MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  (identifiant SMTP + clé SMTP)
#   Mailgun  : MAIL_HOST=smtp.mailgun.org      MAIL_PORT=587
#   Resend   : MAIL_HOST=smtp.resend.com       MAIL_PORT=465  MAIL_SCHEME=smtps  MAIL_USERNAME=resend (mot de passe = clé API)
#   Amazon SES : MAIL_HOST=email-smtp.<région>.amazonaws.com  MAIL_PORT=587
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@quinch.sn"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Front et CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=https://quinch.sn
# Aucune origine localhost, jamais '*' (credentials activés).
CORS_ALLOWED_ORIGINS=https://quinch.sn,https://www.quinch.sn

# ─── Jetons d'authentification ───────────────────────────────────────────────
SANCTUM_TOKEN_EXPIRATION_MINUTES=20160

# ─── Vidéo : nginx sert les fichiers (X-Accel-Redirect) ───────────────────────
VIDEO_ACCEL_REDIRECT=true

# ─── SMS : NON UTILISÉ pour l'instant ─────────────────────────────────────────
# Le numéro de téléphone est facultatif et l'OTP passe par e-mail. Ces réglages
# ne sont plus contrôlés au démarrage ; ils restent pour un usage futur (alertes).
SMS_DRIVER=orange
# Fournisseur de secours (orange | twilio) : utilisé automatiquement si le principal échoue.
# Laisser VIDE tant qu'un second fournisseur n'est pas configuré. Recommandé en production.
SMS_FALLBACK_DRIVER=
# Secondes pendant lesquelles un fournisseur en échec est mis de côté (évite d'attendre son timeout).
SMS_BREAKER_SECONDS=120
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=+221XXXXXXXXX
ORANGE_SMS_SENDER_NAME=QUINCH
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
QUINCH_OTP_TTL_MINUTES=10
QUINCH_OTP_MAX_ATTEMPTS=5
QUINCH_OTP_MAX_PER_HOUR=5
QUINCH_OTP_GLOBAL_PER_HOUR=2000

# ─── Paiements ────────────────────────────────────────────────────────────────
# Wave : clé API + secret de signature des webhooks (tous deux OBLIGATOIRES).
# Aucun mode simulation n'existe plus.
QUINCH_PAYMENT_METHODS=wave
WAVE_BASE_URL=https://api.wave.com/v1
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
# Orange Money : à n'activer (QUINCH_PAYMENT_METHODS=wave,orange_money) qu'une fois
# le compte marchand Sonatel obtenu et les 4 valeurs ci-dessous renseignées.
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/sn/v1
ORANGE_MONEY_AUTH_URL=https://api.orange.com/oauth/v3/token
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

# ─── Fonctionnalités ─────────────────────────────────────────────────────────
QUINCH_FEATURE_NEGOTIATION=true
QUINCH_FEATURE_FOLLOW=true
QUINCH_FEATURE_REVIEWS=true
QUINCH_FEATURE_BADGES=true
QUINCH_FEATURE_SHARING=true
QUINCH_FEATURE_CHAT_AUDIO=true
QUINCH_FEATURE_CHAT_FILE=true
QUINCH_FEATURE_FAVORITES_COLLECTIONS=true
QUINCH_FEATURE_PURCHASES=false

# false = « Premium bientôt disponible » (bêta gratuite : aucun abonnement possible)
QUINCH_PREMIUM_PAYMENTS=true
QUINCH_PREMIUM_PRICE_MONTHLY=2000
QUINCH_PREMIUM_PRICE_ANNUAL=20000
QUINCH_LISTING_FEE_WITH_VIDEO=150

# ─── Connexion Google ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Informations légales (OBLIGATOIRES en production) ───────────────────────
# Affichées dans « Mentions légales », « Conditions » et « Confidentialité ».
# Tant que la société n'existe pas : votre nom et votre adresse, statut « Entrepreneur individuel
# / projet porté à titre individuel ». Quand elle est créée : changer ces valeurs, rien d'autre.
LEGAL_PUBLISHER_NAME=
LEGAL_PUBLISHER_STATUS=
LEGAL_PUBLISHER_ADDRESS=
LEGAL_REGISTRATION_NUMBER=
LEGAL_DIRECTOR=
# Numéro du récépissé de déclaration CDP (à renseigner dès qu'il est délivré).
LEGAL_CDP_RECEIPT=
LEGAL_CONTACT_EMAIL=contact@quinch.sn
LEGAL_PRIVACY_EMAIL=contact@quinch.sn
# Hébergeur et pays exact des serveurs (la CDP demande le lieu de stockage).
LEGAL_HOST_NAME=Contabo GmbH
LEGAL_HOST_LOCATION=
# À changer quand les textes évoluent (chaque inscription mémorise la version acceptée).
LEGAL_TERMS_VERSION=2026-10
LEGAL_PRIVACY_VERSION=2026-10
# Durées de conservation (jours).
LEGAL_ANONYMIZED_CONTENT_DAYS=30
LEGAL_AUDIT_LOGS_DAYS=180

# ─── Médias : disque local ou stockage objet + CDN (docs/STORAGE.md) ──────────
# local : photos et vidéos sur le disque du serveur (développement, très petite bêta).
# s3    : stockage objet compatible S3 (Contabo Object Storage, Cloudflare R2...). Exige
#         composer require league/flysystem-aws-s3-v3 "^3.0" puis de valider composer.lock.
MEDIA_DRIVER=local
# Les valeurs suivantes ne servent qu'avec MEDIA_DRIVER=s3 (endpoint, région et style d'URL :
# à relever dans le panneau de votre fournisseur ; Contabo exige le mode path-style).
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=default
MEDIA_S3_BUCKET=
MEDIA_S3_KEY=
MEDIA_S3_SECRET=
MEDIA_S3_PATH_STYLE=true
# URL publique des médias servie par le CDN (domaine à vous, en https), ex. https://media.quinch.sn
MEDIA_CDN_URL=

# ─── Supervision (docs/MONITORING.md) ─────────────────────────────────────────
# Jeton de GET /api/v1/ops/health (en-tête X-Health-Token). Vide = point de santé désactivé.
#   php -r "echo bin2hex(random_bytes(24));"
HEALTH_TOKEN=
HEALTH_QUEUE_ALERT=1000
HEALTH_DISK_MIN_FREE=15

# ─── PgBouncer (docs/OPERATIONS.md) : à true UNIQUEMENT si DB_HOST=pgbouncer ───
DB_EMULATE_PREPARES=false

# ─── Préproduction uniquement (docs/STAGING.md) : JAMAIS en production ────────
QUINCH_ALLOW_LOADTEST_DATA=false


# ── Mode bêta ──
# true = aucun paiement (publication vidéo gratuite, Premium sans paiement) + messages « version bêta ».
QUINCH_BETA=true
# Offre « Premium offert aux N premiers » : nombre de places et durée offerte (jours).
QUINCH_PREMIUM_OFFER_SLOTS=100
QUINCH_PREMIUM_OFFER_DAYS=90

# Config utilisée par PHPUnit (APP_ENV=testing, voir phpunit.xml).
# Copier vers backend/.env.testing (ignoré par git) et renseigner DB_PASSWORD.
#
# IMPORTANT : pointe vers une base SÉPARÉE de la base de développement/prod
# ("quinch_testing", pas "quinch") — RefreshDatabase efface tout son contenu
# avant chaque test. Ne jamais faire pointer ceci vers votre vraie base.

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Connexion à Postgres via le port exposé par docker-compose (voir
# POSTGRES_HOST_PORT dans le .env racine ; 5433 par défaut chez QUINCH).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=quinch_testing
DB_USERNAME=quinch_user
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# Feature flags V1 : par défaut tout désactivé, comme en production. Les
# tests des fonctionnalités V2 activent explicitement le flag concerné via
# `config(['quinch.features.xxx' => true])` dans le test lui-même si besoin.
QUINCH_PAYMENT_METHODS=cash_delivery

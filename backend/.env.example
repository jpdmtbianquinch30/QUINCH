APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST=127.0.0.1 si Laravel tourne en local (php artisan serve) et se
#         connecte au Postgres du docker-compose via le port exposé.
# DB_HOST=postgres si Laravel tourne lui-même dans le conteneur "app" du
#         docker-compose (nom du service Postgres sur le réseau Docker).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=quinch
DB_USERNAME=quinch_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paiements webhook secrets
ORANGE_MONEY_WEBHOOK_SECRET=
WAVE_WEBHOOK_SECRET=
FREE_MONEY_WEBHOOK_SECRET=

# ─── QUINCH V1 - Feature flags ───────────────────────────────────────────────
# Moyens de paiement actifs (liste separee par des virgules).
# V1: uniquement le paiement a la livraison, en attendant l'integration reelle
# et testee des webhooks Wave / Orange Money / Free Money.
QUINCH_PAYMENT_METHODS=cash_delivery

# Fonctionnalites desactivees en V1 (mettre a true pour les reactiver en V2/V3)
QUINCH_FEATURE_NEGOTIATION=false
QUINCH_FEATURE_FOLLOW=false
QUINCH_FEATURE_REVIEWS=false
QUINCH_FEATURE_BADGES=false
QUINCH_FEATURE_SHARING=false
QUINCH_FEATURE_CHAT_AUDIO=false
QUINCH_FEATURE_CHAT_FILE=false
QUINCH_FEATURE_FAVORITES_COLLECTIONS=false

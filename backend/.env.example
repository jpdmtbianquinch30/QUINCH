APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST=127.0.0.1 si Laravel tourne en local (php artisan serve) et se
#         connecte au Postgres du docker-compose via le port exposé.
# DB_HOST=postgres si Laravel tourne lui-même dans le conteneur "app" du
#         docker-compose (nom du service Postgres sur le réseau Docker).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=quinch
DB_USERNAME=quinch_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local : « log » écrit l'e-mail (donc le code) dans storage/logs/laravel.log.
# Le code part par la file d'attente : lancez « php artisan queue:work » (sinon rien
# n'est écrit dans le journal), ou mettez QUEUE_CONNECTION=sync pour un envoi immédiat.
# Pour tester un vrai SMTP : MAIL_MAILER=smtp puis « php artisan quinch:mail-test vous@gmail.com ».
# MAIL_SCHEME : vide ou « smtp » (port 587), « smtps » (port 465). Jamais « tls » / « ssl ».
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paiements
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/sn/v1
ORANGE_MONEY_AUTH_URL=https://api.orange.com/oauth/v3/token
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

WAVE_BASE_URL=https://api.wave.com/v1
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:4200

# ─── QUINCH V1 - Feature flags ───────────────────────────────────────────────
# Moyens de paiement actifs (liste separee par des virgules).
# V1: Wave est la seule passerelle réelle en place (voir WaveGateway.php).
# Orange Money est présent mais en attente de confirmation des champs
# webhook avec la doc Sonatel — ne pas activer en production avant.
# Nécessite WAVE_API_KEY pour fonctionner (sinon 502 à l'achat).
QUINCH_PAYMENT_METHODS=wave

# Fonctionnalites desactivees en V1 (mettre a true pour les reactiver en V2/V3)
QUINCH_FEATURE_NEGOTIATION=true
QUINCH_FEATURE_FOLLOW=true
QUINCH_FEATURE_REVIEWS=true
QUINCH_FEATURE_BADGES=true
QUINCH_FEATURE_SHARING=true
QUINCH_FEATURE_CHAT_AUDIO=true
QUINCH_FEATURE_CHAT_FILE=true
QUINCH_FEATURE_FAVORITES_COLLECTIONS=true
QUINCH_FEATURE_PURCHASES=false

# Premium (abonnement vendeur) — prix en XOF
QUINCH_PREMIUM_PRICE_MONTHLY=2000
QUINCH_PREMIUM_PRICE_ANNUAL=20000

# Frais de publication d'annonce (comptes non-premium uniquement)
QUINCH_LISTING_FEE_WITH_VIDEO=150

# ─── SMS (NON UTILISÉ pour l'instant : l'OTP passe par e-mail) ───────────────
# log    = SIMULATION (local uniquement) : le code s'affiche à l'écran (« Mode démo »)
#          et dans storage/logs/laravel.log. Aucun SMS ne part.
# orange = vrais SMS via Orange Developer (Sénégal)
# twilio = vrais SMS via Twilio
# Dès que SMS_DRIVER vaut orange ou twilio, le code n'est PLUS jamais renvoyé par l'API.
SMS_DRIVER=log
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER=+221XXXXXXXXX
ORANGE_SMS_SENDER_NAME=QUINCH
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Les SMS partent par la file d'attente : il faut un worker actif
# (php artisan queue:work) ou, en local seulement, QUEUE_CONNECTION=sync.

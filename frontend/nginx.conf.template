# Application Angular : fichiers statiques + en-têtes de sécurité.
# ${API_ORIGIN} (ex. https://api.quinch.sn) et ${CSP_HEADER_NAME} sont injectés au
# démarrage du conteneur. CSP_HEADER_NAME vaut Content-Security-Policy (appliquée) ou
# Content-Security-Policy-Report-Only (observation seule, pour un premier essai en
# préproduction : les violations s'affichent dans la console du navigateur).
#
# ATTENTION : ne jamais ajouter de « add_header » dans un bloc « location » :
# nginx abandonne alors TOUS les en-têtes définis au niveau « server » (donc la
# CSP). Le cache se règle avec « expires », qui n'a pas cet effet.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 16k;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    # ── En-têtes de sécurité ────────────────────────────────────────────────
    add_header ${CSP_HEADER_NAME} "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: ${API_ORIGIN} https://*.googleusercontent.com; media-src 'self' blob: ${API_ORIGIN}; connect-src 'self' ${API_ORIGIN} https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)" always;
    # « allow-popups » : la fenêtre de connexion Google doit pouvoir répondre à la page.
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;

    # Santé (healthcheck Docker)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Fichiers à empreinte (main-XXXXXXXX.js, styles-XXXXXXXX.css) : cache d'un an.
    location ~* "^/.+-[A-Z0-9]{8}\.(js|css)$" {
        expires 1y;
        try_files $uri =404;
    }

    # Le document d'entrée ne doit jamais être mis en cache (nouvelle version = immédiate).
    location = /index.html {
        expires -1;
    }

    # Autres ressources statiques (images, icônes, theme-init.js).
    location ~* \.(png|jpg|jpeg|webp|svg|ico|woff2?|js|css)$ {
        expires 7d;
        try_files $uri =404;
    }

    # Application monopage : toute autre URL renvoie index.html (routage Angular).
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }

    # Fichiers cachés interdits.
    location ~ /\. {
        deny all;
    }
}

POSTGRES_DB=quinch
POSTGRES_USER=quinch_user
# Secrets : au moins 24 caractères aléatoires, JAMAIS les valeurs d'exemple.
#   php -r "echo bin2hex(random_bytes(24));"
POSTGRES_PASSWORD=CHANGER_MOI

# Doit être identique à REDIS_PASSWORD dans backend/.env.docker
REDIS_PASSWORD=CHANGER_MOI_AUSSI
REDIS_MAXMEMORY=512mb

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGER_MOI

# ─── Production (docker-compose.prod.yml) : HTTPS automatique ────────────────
# API_DOMAIN=api.quinch.sn
# APP_DOMAIN=quinch.sn
# ACME_EMAIL=vous@quinch.sn

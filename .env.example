# Variables utilisées par docker-compose.yml (PAS le .env de Laravel, qui est
# dans backend/.env — celui-ci ne concerne que les conteneurs eux-mêmes).
#
# Copier ce fichier vers `.env` à la racine et renseigner de vraies valeurs :
#   cp .env.example .env
# Le fichier `.env` réel est ignoré par git (voir .gitignore), il ne doit
# jamais être commité.

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=quinch
POSTGRES_USER=quinch_user
POSTGRES_PASSWORD=changeme_use_a_strong_password

# ─── pgAdmin (interface web d'admin Postgres, optionnelle) ───────────────────
PGADMIN_DEFAULT_EMAIL=admin@quinch.sn
PGADMIN_DEFAULT_PASSWORD=changeme_use_a_strong_password

# ─── Build Flutter (optionnel, pour le service ci mobile si utilisé) ─────────
API_BASE_URL=https://api.quinch.sn

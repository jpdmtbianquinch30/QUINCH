# ─── Variables lues par docker-compose.yml (fichier « .env » à la RACINE) ─────
# Copier : cp .env.example .env   puis remplacer TOUTES les valeurs CHANGE_ME.
# Générer un mot de passe : openssl rand -base64 32
# Ne jamais committer le vrai .env.

POSTGRES_DB=quinch
POSTGRES_USER=quinch_user
POSTGRES_PASSWORD=CHANGE_ME

# Doit être IDENTIQUE à REDIS_PASSWORD dans backend/.env.docker
REDIS_PASSWORD=CHANGE_ME
REDIS_MAXMEMORY=512mb

# pgAdmin (profil optionnel : docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=admin@quinch.sn
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
